{
  "skill": "the-standard-foundations",
  "version": "2.0.0",
  "naming": {
    "interface_pattern": "I{Entity}Service",
    "interface_substrate_pattern": "I{Entity}Service.Substrate.cs",
    "concrete_pattern": "{Entity}Service",
    "do_work_pattern": "Do{Operation}{Entity}Async",
    "event_handler_pattern": "On{PresentTenseOperation}{Entity}Async",
    "event_operation_enum": "{Entity}EventOperation",
    "request_address_pattern": "{Entity}-{PresentTenseOperation}",
    "fact_address_pattern": "{Entity}-{PastTenseOperation}",
    "subscription_name_pattern": "{Entity}Service.On{PresentTenseOperation}{Entity}"
  },
  "structural_validation_checks": [
    "null model",
    "null required string properties",
    "empty required string properties",
    "whitespace-only required string properties",
    "default Guid (Guid.Empty)",
    "default DateTimeOffset",
    "string length caps enforced in the service, not left to the column",
    "CreatedBy matches the acting user id resolved from the envelope's SecurityContext",
    "audit dates are recent",
    "CreatedBy / CreatedWhen unchanged against storage on modify"
  ],
  "exception_mapping": {
    "note": "Inner exceptions are public and carry no 'Service' in the name; only the four outer wrappers and Failed{Entity}ServiceException do.",
    "DuplicateKeyException": "AlreadyExists{Entity}Exception",
    "DuplicateKeyWithUniqueIndexException": "AlreadyExists{Entity}Exception",
    "ForeignKeyConstraintConflictException": "Invalid{Entity}ReferenceException",
    "DbUpdateConcurrencyException": "Locked{Entity}Exception",
    "DbUpdateException": "FailedStorage{Entity}Exception",
    "SqlException": "FailedStorage{Entity}Exception",
    "OperationCanceledException (not requested)": "Timeout{Entity}Exception",
    "unhandled": "Failed{Entity}ServiceException",
    "null_model": "Null{Entity}Exception",
    "invalid_model": "Invalid{Entity}Exception",
    "missing_row": "NotFound{Entity}Exception",
    "denied_caller": "Unauthorized{Entity}Exception",
    "malformed_or_unsigned_envelope": "Invalid{Entity}EventException"
  },
  "outer_wrappers": {
    "validation": "{Entity}ValidationException",
    "dependency_validation": "{Entity}DependencyValidationException",
    "dependency": "{Entity}DependencyException",
    "service": "{Entity}ServiceException"
  },
  "audit_broker_contract": {
    "note": "The ambient overloads were removed. Only the SecurityContext-carrying ones exist, so passing identity is a compile-time requirement rather than a convention.",
    "required": [
      "ApplyAddAuditValuesAsync<T>(T entity, SecurityContext securityContext)",
      "ApplyModifyAuditValuesAsync<T>(T entity, SecurityContext securityContext)",
      "ApplyRemoveAuditValuesAsync<T>(T entity, SecurityContext securityContext, string? deletionReason = null)",
      "GetUserIdAsync(SecurityContext securityContext)"
    ],
    "removed": [
      "ApplyAddAuditValuesAsync<T>(T entity)",
      "ApplyModifyAuditValuesAsync<T>(T entity)",
      "ApplyRemoveAuditValuesAsync<T>(T entity, string? deletionReason = null)",
      "GetUserIdAsync()"
    ]
  },
  "structure": {
    "partial_class_required": true,
    "files_per_entity": [
      "{Entity}Service.cs",
      "{Entity}Service.Substrate.cs",
      "{Entity}Service.Validations.cs",
      "{Entity}Service.Exceptions.cs"
    ],
    "optional_partials": [
      "{Entity}Service.Transitions.cs",
      "{Entity}Service.Transitions.Validations.cs",
      "{Entity}Service.Lookup.cs"
    ],
    "brokers": [
      "IStorageBroker",
      "IDateTimeBroker",
      "IIdentifierBroker",
      "IEventBroker",
      "IEventEnvelopeBroker",
      "ISecurityAuditBroker",
      "IEnvelopeIntegrityBroker",
      "ILoggingBroker"
    ],
    "brokers_note": "The eight above are the baseline every foundation service takes. An entity that joins the approval workflow additionally injects IAccessBroker and calls it from its .Transitions.Validations partial (MayDecideApprovalAsync and friends) — 10 of the 12 current services do. IAccessBroker is NOT for ordinary role or ownership gating: that is inline SecurityContext checking, as the template shows. Add it only when the entity has approval transitions.",
    "can_call_other_services": false,
    "dual_path_required_for": ["Adding", "Modifying", "RemovingById", "HardRemovingById", "RetrievingById"],
    "dual_path_excluded": {
      "RetrieveAll{Entity}sAsync": "No request address, no handler, no DoXAsync. It mints an envelope only to capture the caller for the visibility filter, and does its work inline. Do not add an OnRetrievingAll handler."
    },
    "processed_events_dedup_required_on_mutations": true
  }
}
